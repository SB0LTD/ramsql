.{
    .protocol_version = 1,
    .scope = "sb0",
    .name = "ramsql",
    .version = "0.3.0-alpha.4",
    .layer = 0,
    .platform = .any,
    .system_libraries = .{},
    .zpm_dependencies = .{ "@zpm/sql@0.1.0" },
    .exports = .{ "ramsql" },
    .description = "Allocator-free in-memory SQL database in pure Sig",
    .license = "MIT",
    .repository = "https://github.com/SB0LTD/ramsql",
    .constraints = .{
        .no_allocator = true,
        .no_std_io = true,
    },
}
